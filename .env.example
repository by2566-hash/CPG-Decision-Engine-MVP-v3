# ── Database ──────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=decision_engine_v3
POSTGRES_USER=decision_engine
POSTGRES_PASSWORD=change_me

# ── Redis ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── AWS (DynamoDB / S3 / SQS) ────────────────────────
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DYNAMODB_TABLE_PREFIX=v3_

# ── Shopline API ──────────────────────────────────────
SHOPLINE_API_BASE_URL=
SHOPLINE_API_KEY=
SHOPLINE_API_SECRET=

# ── Meta Ads API ──────────────────────────────────────
META_ADS_ACCESS_TOKEN=
META_ADS_ACCOUNT_ID=

# ── GA4 ───────────────────────────────────────────────
GA4_PROPERTY_ID=
GA4_CREDENTIALS_JSON=

# ── LLM ──────────────────────────────────────────────
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# ── Application ───────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
FAST_PLANE_LATENCY_BUDGET_MS=50
